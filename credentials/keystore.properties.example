# PocketBrain upload keystore properties (LOCAL ONLY — never commit)

# Copy to android/keystore.properties after prebuild (android/ is generated).
# Paths for storeFile are relative to the android/ directory when using Gradle Properties load from android/keystore.properties.

storeFile=../credentials/pocketbrain-upload.jks
storePassword=REPLACE_ME
keyAlias=pocketbrain-upload
keyPassword=REPLACE_ME
